# GEMINI_API_KEY: Required for Gemini AI API calls (AI Import).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (required for Stripe redirect URLs).
APP_URL="http://localhost:3000"

# Admin emails (comma-separated) — these Google accounts get ADMIN role
ADMIN_EMAILS="antoniobellanova1812@gmail.com,belllanovaantonio1@gmail.com"

# PostgreSQL — Neon DATABASE_URL (empfohlen) ODER lokale SQL_* Variablen
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="bellanova_luxury"
SQL_USER="postgres"
SQL_PASSWORD="your_password"

# Alternative names used by drizzle-kit
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_password"

# Firebase is configured via firebase-applet-config.json (AI Studio)

# E-Mail (Resend) — Bestellbestätigungen & Anfragen
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Antonio Bellanova <antonio.bellanova@antoniobellanova.com>"

# Stripe — Online-Zahlung im Checkout (Hosted Checkout)
# Test Mode: use keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."  # from Stripe CLI or Dashboard webhook endpoint
#
# Webhook endpoint URL (production):
#   https://YOUR-DOMAIN.onrender.com/api/stripe/webhook
#
# Local webhook testing:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
#
# Required webhook events:
#   checkout.session.completed
#   checkout.session.expired
#   payment_intent.succeeded
#   payment_intent.payment_failed
#   charge.refunded
#
# Apple Pay / Google Pay: enable in Stripe Dashboard → Settings → Payment methods.
# They appear automatically in Stripe Checkout on supported devices.
