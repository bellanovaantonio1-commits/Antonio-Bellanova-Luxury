# GEMINI_API_KEY: Required for Gemini AI API calls (AI Import).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL — use DATABASE_URL (Render/Neon) OR individual SQL_* vars (local)
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="bellanova_luxury"
SQL_USER="postgres"
SQL_PASSWORD="your_password"

# Alternative names used by drizzle-kit
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_password"

# Firebase is configured via firebase-applet-config.json (AI Studio)
